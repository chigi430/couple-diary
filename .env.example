# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
# Supabase 대시보드 → Settings → API Keys 에서 확인.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# 다녀온 장소 지도 기능용 (Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키).
# 플랫폼 설정 → Web → 사이트 도메인에 http://localhost:5173 과 실제 배포 도메인을 둘 다 등록해야 지도가 뜹니다.
VITE_KAKAO_MAP_APP_KEY=your-kakao-javascript-key

# 푸시 알림용 VAPID 공개키 (npx web-push generate-vapid-keys 로 생성, 비밀키는 여기 넣지 말 것)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
